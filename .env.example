# Leave unset for non-API local tasks. Provide a strong secret through a secret
# manager (never commit a real value) before enabling an authenticated API.
DERIVS_SYMBOL=BTCUSDT
DERIVS_EXCHANGE=binance
DERIVS_DATA_DIR=./data/lake
DERIVS_MODEL_VERSION=robust-zscore-v1
DERIVS_API_HOST=127.0.0.1
DERIVS_API_PORT=8000
DERIVS_OI_POLL_SECONDS=15
DERIVS_CAPTURE_SECONDS=300
DERIVS_ZSCORE_THRESHOLD=6.0
DERIVS_ALERT_MERGE_MINUTES=15
DERIVS_EVENTHUB_NAMESPACE=
DERIVS_EVENTHUB_NAME=
DERIVS_STORAGE_ACCOUNT_URL=
DERIVS_MLFLOW_TRACKING_URI=
